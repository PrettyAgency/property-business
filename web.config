        <rule name="att6" stopProcessing="true"><match url="^getattachment/25bd7d1d\-4fe2\-4fe6\-b59e\-9ad0f91b67de/download$" ignoreCase="true" /><action type="Redirect" url="/assets/downloads/The-Big-Shift-PNG.PNG" redirectType="Permanent" /></rule>
