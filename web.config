        <rule name="att28" stopProcessing="true"><match url="^getattachment/ed3fd403\-f26e\-4866\-a8ad\-7299b896bf6d/download$" ignoreCase="true" /><action type="Redirect" url="/assets/downloads/sunshine-coast-major_projects_map_0321.pdf" redirectType="Permanent" /></rule>
        <rule name="att29" stopProcessing="true"><match url="^getattachment/f54abce9\-9f45\-47e3\-8631\-bbbe157c9c27/download$" ignoreCase="true" /><action type="Redirect" url="/assets/downloads/Building-your-investment-portfolio.doc" redirectType="Permanent" /></rule>
        <rule name="att30" stopProcessing="true"><match url="^getattachment/f86c85fa\-5ab8\-4853\-bd14\-aba7bed93632/download$" ignoreCase="true" /><action type="Redirect" url="/assets/downloads/Investing-in-a-holiday-property.doc" redirectType="Permanent" /></rule>
