<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>
    <staticContent>
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" /><error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite><rules>
        <rule name="Home alias" stopProcessing="true"><match url="^home/?$" ignoreCase="true" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
        <rule name="att0" stopProcessing="true"><match url="^getattachment/0f07b8ea\-e009\-4f13\-9704\-cbbbdb56badb/Sunshine\-coast\-buyers\-agent\-live\-music\-venue\-aura\.PNG$" ignoreCase="true" /><action type="Redirect" url="/assets/images/attachments/Sunshine-coast-buyers-agent-live-music-venue-aura.PNG" redirectType="Permanent" /></rule>
        <rule name="att1" stopProcessing="true"><match url="^getattachment/125ca185\-a189\-4040\-a765\-a4a5e583175e/download$" ignoreCase="true" /><action type="Redirect" url="/assets/downloads/OperationalPlan202223.pdf" redirectType="Permanent" /></rule>
